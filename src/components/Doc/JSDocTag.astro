---
import { marked } from "marked";
import CustomCode from "../Content/CustomCode.astro";
import TypeLink from "./TypeLink.astro";
import { experimental_AstroContainer } from "astro/container";
import type { BundledLanguage } from "shiki";

export interface Props {
    tag: string;
    items: any[];
    paramName?: string;
}

const { tag, items, paramName } = Astro.props;

const container = await experimental_AstroContainer.create();
const parse = async (e: any) => {
    if (e === null) return "";
    if (typeof e === "string") return await marked.parseInline(e);
    if (e?.kind === "JSDocText") return await marked.parseInline(e?.text ?? "");
    if (e?.kind === "JSDocLink") {
        return container.renderToString(TypeLink, {
            props: {
                name: e.name,
                html: await marked.parseInline(e.text),
            },
        });
    }
    return "";
};
const itemsHtml = await (async () => (await Promise.all(items.flat().map(parse))).join(""))();

const parseExample = async (txt: string) => {
    const match = txt.match(/([\s\S]*?)```(js|ts)*\n([\s\S]*?)```/);

    return {
        label: await parse(match?.[1].trim() ?? ""),
        code: match?.[3].trim() ?? txt.replace(/^[\s\S]*?```(js|ts)\s+|```$/g, ""),
        lang: (match?.[2] as BundledLanguage) ?? "js",
    };
};

const richSpanClass = "prose-code:font-code prose-code:font-normal prose-code:bg-base-300/55 prose-code:rounded-lg prose-code:py-1 [&_*]:box-decoration-clone";
---

{
    tag === "example" ? (
        items.map(async (e) => {
            const { label, code, lang } = await parseExample(e);
            return (
                <>
                    {label && (
                        <p class="prose" data-jsdoc-tag>
                            <code data-jsdoc-name class="py-0.5 px-1.5 font-medium whitespace-normal" set:text="example" />{" "}
                            <span data-jsdoc-describe class={richSpanClass} set:html={label} />
                        </p>
                    )}

                    <CustomCode code={code} data-language={lang} data-jsdoc-example classForWindow="my-4" />
                </>
            );
        })
    ) : tag === "param" ? (
        <p class="prose" data-jsdoc-tag>
            <code data-jsdoc-name class="py-0.5 px-1.5 font-medium">
                {tag}
            </code>{" "}
            <span data-jsdoc-describe>{paramName ?? "unknown"}</span>&#32;
            <span data-jsdoc-value class={richSpanClass} set:html={itemsHtml} />
        </p>
    ) : (
        <p class="prose" data-jsdoc-tag>
            <code data-jsdoc-name class="py-0.5 px-1.5 font-medium">
                {tag}
            </code>{" "}
            <span data-jsdoc-value class={richSpanClass} set:html={itemsHtml} />
        </p>
    )
}
