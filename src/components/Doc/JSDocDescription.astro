---
import { marked } from "marked";
import TypeLink from "./TypeLink.astro";

const { data } = Astro.props;
const jsDoc = data?.jsDoc;
const doc: any[] = jsDoc?.doc ?? [];
---

{
    jsDoc ? (
        <p
            class="prose max-w-none pb-2 prose-code:font-code prose-code:font-normal prose-code:bg-base-300/55 prose-code:rounded-lg prose-code:py-1 [&_*]:box-decoration-clone"
            data-pagefind-weight="5"
            data-jsdoc-description
        >
            {doc.map((e) => (
                <>
                    {e.kind === "JSDocText" && <Fragment set:html={marked.parseInline(e.text)} />}
                    {e.kind === "JSDocLink" && (
                        <TypeLink name={e.name}>
                            <span set:html={marked.parseInline(e.text, {})} />
                        </TypeLink>
                    )}
                </>
            ))}
        </p>
    ) : null
}
