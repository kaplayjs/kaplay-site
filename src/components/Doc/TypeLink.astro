---
import { doc } from "@/data/doc";

interface Props {
    name:
        | string
        | {
              kind: string;
              left: { kind: string; escapedText: string };
              right: { kind: string; escapedText: string };
          };
    html?: string;
}

const { name: nameSrc, html } = Astro.props;
let name = nameSrc;
let namespaced: string[] = [];
let formattedName = html || name;

if (typeof name === "object") {
    namespaced = Object.values(name)
        .map((v) => (typeof v === "object" ? v.escapedText : undefined))
        .filter((v) => typeof v === "string");
    name = namespaced[0] === "KAPLAYCtx" ? namespaced[1] : namespaced.join("-");
    if (!html) formattedName = namespaced.join(".");
}

const ctxMember = doc.types.KaboomCtx?.[0].members[name] ?? doc.types.KAPLAYCtx?.[0].members[name];
const typesMember = doc.types[name];
const namespaceMember = !ctxMember && doc.types[namespaced[0]]?.[0]?.members?.[namespaced[1]];

let isTypesMember = Boolean(typesMember);
let isCtxMember = Boolean(ctxMember);
let isNamespaceMember = Boolean(namespaceMember);
let isType = isTypesMember || isCtxMember || isNamespaceMember;

if (name == "KAPLAYCtx") {
    isType = false;
    isTypesMember = false;
}

const props = isType
    ? {
          "data-type-link": isType,
          "data-link-type": `${isTypesMember ? "/" : isNamespaceMember ? `/${namespaced[0]}#` : "/ctx/"}${name}`,
      }
    : {};
---

<span
    {...props}
    data-dg-reference
    class:list={{
        // prettier-ignore
        "hoverable link link-primary link-hover underline decoration-current decoration-dashed underline-offset-2 [&_*]:text-[inherit] transition-colors": isType,
    }}
    set:html={(await Astro.slots.render("default")) || formattedName}
/>
