---
import TypeLink from "../TypeLink.astro";
import type { DataTypeProps } from "../Utils/types.ts";

export type DataTypeQuery = {
    kind: "TypeQuery";
    exprName: {
        kind: "Indentifier";
        escapedText: "initApp";
    };
};

interface Props extends DataTypeProps {
    data: DataTypeQuery;
}

const { data } = Astro.props;
---

<span data-dg-type-query>typeof <TypeLink name={data.exprName.escapedText} /></span>
